// Rain: green drops falling from the top, dimming as they go, The Matrix's rain.
// From sublimeRain in jasoncoon/fibonacci128-touch-demo (GPL-3.0), after the Sublime demos; for f128.mll.

class F128RainEffect {
  byte dx[16];
  byte dy[16];
  byte db[16];
  int frame = 0;

  int dimensions() { return 2; }

  string tags() { return "💫"; }

  // Light n where f128.mll puts it: x and y on the sketch's 0..255 board, its grid cell in z.
  Coord3D led(int n) {
    int r = 0;
    int s = 128;
    for (int k = 0; k < 8; k = k + 1) {
      if ((r + s) * (r + s) <= 128 * n + 64) { r = r + s; }
      s = s / 2;
    }
    int x = 128 + (cos(n * 25033) - 32768) * r / 32768;
    int y = 128 + (sin(n * 25033) - 32768) * r / 32768;
    return Coord3D(x, y, (y - 3) * (height - 1) / 246 * width + (x - 2) * (height - 1) / 250);
  }
  void tick() {
    // The sketch moved once a frame at 120 frames a second; this steps that many times for the time
    // gone, at most four, so the motion keeps its speed at any framerate.
    int now = t / 25 * 3 + mod(t, 25) * 3 / 25;
    int steps = clamp(now - frame, 1, 4);
    frame = now;
    for (int k = 0; k < steps; k = k + 1) {
      for (int d = 0; d < 16; d = d + 1) {
        if (db[d] > 0) {
          if (dy[d] < 5 || db[d] < 42) { db[d] = 0; }
          else { dy[d] = dy[d] - 5; db[d] = db[d] - 2; }
        } else {
          // The sketch started a drop up to 20 above the top; a byte starts it at the top.
          if (random16(256) < 40) {
            dx[d] = random16(255);
            dy[d] = 255;
            db[d] = 180 + random16(76);
          }
        }
      }
    }
    fade(106);
    for (int n = 0; n < 128; n = n + 1) {
      Coord3D p = led(n);
      for (int d = 0; d < 16; d = d + 1) {
        if (db[d] > 0) {
          int e = (p.x - dx[d]) * (p.x - dx[d]) + (255 - p.y - dy[d]) * (255 - p.y - dy[d]);
          if (e < 225) {
            int bri = 255 * (225 - e) / 225 * (db[d] + 1) / 256;
            addRGB(p.z, 0, bri, bri * 41 / 256);
          }
        }
      }
    }
  }
}
