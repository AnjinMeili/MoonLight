// Spiral: two arms half a turn apart sweep round, their tightness and width breathing.
// From spiral in jasoncoon/fibonacci128-touch-demo (GPL-3.0), after Aurora's PatternSpiral by Stefan
// Petrick; for f128.mll.

class F128SpiralEffect {
  int dimensions() { return 2; }

  string tags() { return "💫"; }

  // Light n where f128.mll puts it: the sketch's angle and radius (0..255) in x and y, its grid cell in z.
  Coord3D led(int n) {
    int r = 0;
    int s = 128;
    for (int k = 0; k < 8; k = k + 1) {
      if ((r + s) * (r + s) <= 128 * n + 64) { r = r + s; }
      s = s / 2;
    }
    int x = 128 + (cos(n * 25033) - 32768) * r / 32768;
    int y = 128 + (sin(n * 25033) - 32768) * r / 32768;
    return Coord3D(mod(n * 25033 / 256 + 128, 256), r * 2, (y - 3) * (height - 1) / 246 * width + (x - 2) * (height - 1) / 250);
  }
  void tick() {
    fade(74);
    int base = beat(7, t) / 256;
    int tight = 1 + scale(sin(beat(3, t)), 2);
    int width8 = 10 + scale(sin(beat(5, t)), 10);
    for (int n = 0; n < 128; n = n + 1) {
      Coord3D p = led(n);
      for (int arm = 0; arm < 2; arm = arm + 1) {
        // The shorter way round from the arm's angle at this radius.
        int diff = mod(p.x - (base + p.y * tight + arm * 128) + 512, 256);
        if (diff > 128) { diff = 256 - diff; }
        if (diff < width8) {
          addRGB(p.z, paletteRGB(mod(p.y + beat(11, t) / 256 + arm * 80, 256), 255 * (width8 - diff) / width8));
        }
      }
    }
  }
}
