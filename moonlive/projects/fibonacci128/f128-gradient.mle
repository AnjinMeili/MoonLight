// Gradient: the palette or the rainbow laid across the board and scrolled, outward along the spiral,
// round it, or straight across.
// From outwardPalettes, outwardRainbow, rotatingPalettes, rotatingRainbow and the horizontal, vertical
// and diagonal rainbows in jasoncoon/fibonacci128-touch-demo (GPL-3.0); for f128.mll.

class F128GradientEffect {
  byte sweep = 0;
  byte colors = 0;
  byte speed = 30;

  int dimensions() { return 2; }

  string tags() { return "💫"; }

  void defineControls() {
    addSelect("sweep", sweep, "outward|rotating|horizontal|vertical|diagonal"); // which way the colors run
    addSelect("colors", colors, "palette|rainbow"); // the active palette, or the sketch's hue wheel
    addControl("speed", speed, 1, 120); // ms per step of the scroll
  }

  // Light n where f128.mll puts it: x and y on the sketch's 0..255 board, its grid cell in z.
  Coord3D led(int n) {
    int r = 0;
    int s = 128;
    for (int k = 0; k < 8; k = k + 1) {
      if ((r + s) * (r + s) <= 128 * n + 64) { r = r + s; }
      s = s / 2;
    }
    int x = 128 + (cos(n * 25033) - 32768) * r / 32768;
    int y = 128 + (sin(n * 25033) - 32768) * r / 32768;
    return Coord3D(x, y, (y - 3) * (height - 1) / 246 * width + (x - 2) * (height - 1) / 250);
  }
  // FastLED's scale8: a byte scaled by a byte.
  int s8(int a, int b) { return a * (b + 1) / 256; }
  // FastLED's rainbow hue wheel, which the sketch's CHSV lit: eight sections of 32, yellow widened.
  RGB hsv(int h, int s, int v) {
    h = mod(mod(h, 256) + 256, 256);
    int third = s8(mod(h, 32) * 8, 85);
    int sec = h / 32;
    int r = 0;
    int g = 0;
    int b = 0;
    if (sec == 0) { r = 255 - third; g = third; }
    if (sec == 1) { r = 171; g = 85 + third; }
    if (sec == 2) { r = 171 - third * 2; g = 170 + third; }
    if (sec == 3) { g = 255 - third; b = third; }
    if (sec == 4) { g = 171 - third * 2; b = 85 + third * 2; }
    if (sec == 5) { r = third; b = 255 - third; }
    if (sec == 6) { r = 85 + third; b = 171 - third; }
    if (sec == 7) { r = 170 + third; b = 85 - third; }
    // Saturation and value squared as FastLED's scale8_video squares them, a lit light keeping at least 1.
    int desat = s8(255 - s, 255 - s);
    if (s < 255) { desat = desat + 1; }
    int vv = s8(v, v);
    if (v > 0) { vv = vv + 1; }
    return RGB(s8(s8(r, 255 - desat) + desat, vv), s8(s8(g, 255 - desat) + desat, vv), s8(s8(b, 255 - desat) + desat, vv));
  }
  void tick() {
    int hue = t / speed;
    for (int n = 0; n < 128; n = n + 1) {
      Coord3D p = led(n);
      // Outward and round scroll inward, the straight sweeps scroll the other way, as the sketch had them.
      int v = n - hue;
      if (sweep == 1) { v = n * 25033 / 256 + 128 - hue; }
      if (sweep == 2) { v = p.x + hue; }
      if (sweep == 3) { v = p.y + hue; }
      if (sweep == 4) { v = p.x + p.y + hue; }
      if (colors == 0) { setRGB(p.z, paletteRGB(mod(mod(v, 256) + 256, 256), 255)); }
      else { setRGB(p.z, hsv(v, 255, 255)); }
    }
  }
}
