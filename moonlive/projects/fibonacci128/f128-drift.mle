// Drift: fifteen dots on concentric orbits, the inner ones faster, so the rings slide in and out of line.
// From incrementalDrift in jasoncoon/fibonacci128-touch-demo (GPL-3.0), after Aurora's
// PatternIncrementalDrift by Jason Coon; for f128.mll.

class F128DriftEffect {
  // Each ring's dot this frame, worked out once rather than once per light.
  byte dotX[14];
  byte dotY[14];

  int dimensions() { return 2; }

  string tags() { return "💫"; }

  // Light n where f128.mll puts it: x and y on the sketch's 0..255 board, its grid cell in z.
  Coord3D led(int n) {
    int r = 0;
    int s = 128;
    for (int k = 0; k < 8; k = k + 1) {
      if ((r + s) * (r + s) <= 128 * n + 64) { r = r + s; }
      s = s / 2;
    }
    int x = 128 + (cos(n * 25033) - 32768) * r / 32768;
    int y = 128 + (sin(n * 25033) - 32768) * r / 32768;
    return Coord3D(x, y, (y - 3) * (height - 1) / 246 * width + (x - 2) * (height - 1) / 250);
  }
  // Add a palette color to light p, brighter the nearer it lies to (dx, dy), out to 20 units on the
  // board: the sketch's way of drawing a point on lights that sit on no grid.
  void dot(Coord3D p, int dx, int dy, int index) {
    int d = (p.x - dx) * (p.x - dx) + (p.y - dy) * (p.y - dy);
    if (d < 400) { addRGB(p.z, paletteRGB(mod(mod(index, 256) + 256, 256), 255 * (400 - d) / 400)); }
  }
  void tick() {
    // The sketch faded by 255 - beatsin8(2, 210, 230) at 120 frames a second; fade() asks per sixtieth.
    int a = 25 - scale(sin(beat(2, t)), 20);
    fade(256 - (256 - a) * (256 - a) / 256);
    // Ring i orbits 8i out at 2(17 - i) BPM; the sketch's sixteenth ring wraps to the corner, off the board.
    for (int i = 2; i < 16; i = i + 1) {
      int b = beat((17 - i) * 2, t);
      dotX[i - 2] = 128 - i * 8 + scale(cos(b), i * 16);
      dotY[i - 2] = 128 - i * 8 + scale(sin(b), i * 16);
    }
    for (int n = 0; n < 128; n = n + 1) {
      Coord3D p = led(n);
      for (int i = 0; i < 14; i = i + 1) { dot(p, dotX[i], dotY[i], i * 15); }
    }
  }
}
