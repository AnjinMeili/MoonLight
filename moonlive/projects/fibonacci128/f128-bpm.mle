// BPM: palette bands rippling out from the center, pulsing at 62 beats a minute.
// From sublimeBpm in jasoncoon/fibonacci128-touch-demo (GPL-3.0), after the Sublime demos; for f128.mll.

class F128BpmEffect {
  byte bpm = 62;

  int dimensions() { return 2; }

  string tags() { return "💫"; }

  void defineControls() {
    addControl("bpm", bpm, 1, 200); // the pulse
  }

  // Light n where f128.mll puts it: the sketch's angle and radius (0..255) in x and y, its grid cell in z.
  Coord3D led(int n) {
    int r = 0;
    int s = 128;
    for (int k = 0; k < 8; k = k + 1) {
      if ((r + s) * (r + s) <= 128 * n + 64) { r = r + s; }
      s = s / 2;
    }
    int x = 128 + (cos(n * 25033) - 32768) * r / 32768;
    int y = 128 + (sin(n * 25033) - 32768) * r / 32768;
    return Coord3D(mod(n * 25033 / 256 + 128, 256), r * 2, (y - 3) * (height - 1) / 246 * width + (x - 2) * (height - 1) / 250);
  }
  void tick() {
    int pulse = 64 + scale(sin(beat(bpm, t)), 191);
    int hue = t / 30;
    for (int n = 0; n < 128; n = n + 1) {
      Coord3D p = led(n);
      setRGB(p.z, paletteRGB(mod(hue + p.y / 8, 256), mod(pulse - hue + p.y / 4 + 65536, 256)));
    }
  }
}
