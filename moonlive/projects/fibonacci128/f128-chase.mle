// Chase: a bright pulse runs out and back along each Fibonacci spiral arm in turn, the arm count
// stepping through 5, 8, 13 and 3 every 12 seconds.
// From fibonacciChase in jasoncoon/fibonacci128-touch-demo (GPL-3.0); for f128.mll.

class F128ChaseEffect {
  int dimensions() { return 2; }

  string tags() { return "💫"; }

  // Light n where f128.mll puts it: x and y on the sketch's 0..255 board, its grid cell in z.
  Coord3D led(int n) {
    int r = 0;
    int s = 128;
    for (int k = 0; k < 8; k = k + 1) {
      if ((r + s) * (r + s) <= 128 * n + 64) { r = r + s; }
      s = s / 2;
    }
    int x = 128 + (cos(n * 25033) - 32768) * r / 32768;
    int y = 128 + (sin(n * 25033) - 32768) * r / 32768;
    return Coord3D(x, y, (y - 3) * (height - 1) / 246 * width + (x - 2) * (height - 1) / 250);
  }
  void tick() {
    fade(135);
    int pick = mod(t / 12000, 4);
    int arms = 5;
    if (pick == 1) { arms = 8; }
    if (pick == 2) { arms = 13; }
    if (pick == 3) { arms = 3; }
    int len = 128 / arms;
    for (int arm = 0; arm < arms; arm = arm + 1) {
      // Arm by arm a quarter-beat apart, so the pulses chase round in sequence.
      int phase = arm * (256 / arms);
      int dot = scale(sin(beat(20, t) + phase * 256), len - 1);
      for (int pos = 0; pos < len; pos = pos + 1) {
        int dist = abs(pos - dot);
        if (dist < 5) {
          addRGB(led(arm + pos * arms).z, paletteRGB(mod(t / 20 + phase + pos * 4, 256), 255 - dist * 50));
        }
      }
    }
  }
}
