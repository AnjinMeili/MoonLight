// Wave: dots strung along a quadratic wave, once or mirrored, across or down the board, the whole
// figure slowly turning; orientation and mirroring re-drawn every 10 seconds.
// From wave in jasoncoon/fibonacci128-touch-demo (GPL-3.0), after Aurora's PatternWave by Jason Coon;
// for f128.mll.

class F128WaveEffect {
  int rot = 0;
  int phase = 0;
  int phaseSpeed = 0;
  int maxSpeed = 0;
  int win8 = 0;
  int win10 = -1;
  int shape = 0;
  int frame = 0;
  // Each dot's height on the wave this frame, worked out once rather than once per light.
  byte crest[32];

  int dimensions() { return 2; }

  string tags() { return "💫"; }

  // Light n where f128.mll puts it: x and y on the sketch's 0..255 board, its grid cell in z.
  Coord3D led(int n) {
    int r = 0;
    int s = 128;
    for (int k = 0; k < 8; k = k + 1) {
      if ((r + s) * (r + s) <= 128 * n + 64) { r = r + s; }
      s = s / 2;
    }
    int x = 128 + (cos(n * 25033) - 32768) * r / 32768;
    int y = 128 + (sin(n * 25033) - 32768) * r / 32768;
    return Coord3D(x, y, (y - 3) * (height - 1) / 246 * width + (x - 2) * (height - 1) / 250);
  }
  // Add a palette color to light p, brighter the nearer it lies to (dx, dy), out to 20 units on the
  // board: the sketch's way of drawing a point on lights that sit on no grid.
  void dot(Coord3D p, int dx, int dy, int index) {
    int d = (p.x - dx) * (p.x - dx) + (p.y - dy) * (p.y - dy);
    if (d < 400) { addRGB(p.z, paletteRGB(mod(mod(index, 256) + 256, 256), 255 * (400 - d) / 400)); }
  }
  // Light p turned by the rotation about the board's center, its cell kept.
  Coord3D turned(Coord3D p) {
    int c = cos(rot) - 32768;
    int s = sin(rot) - 32768;
    return Coord3D(128 + (c * (p.x - 128) - s * (p.y - 128)) / 32768, 128 + (s * (p.x - 128) + c * (p.y - 128)) / 32768, p.z);
  }
  // FastLED's quadwave8: a triangle wave eased quadratically at both ends, 0..255.
  int quad(int x) {
    int tri = mod(mod(x, 256) + 256, 256);
    if (tri >= 128) { tri = 255 - tri; }
    tri = tri * 2;
    int j = tri;
    if (j >= 128) { j = 255 - j; }
    int e = j * (j + 1) / 256 * 2;
    if (tri >= 128) { e = 255 - e; }
    return e;
  }

  void tick() {
    if (t / 10000 != win10) {
      win10 = t / 10000;
      // The orientation in 0..3 (across, down, across backward, down backward), twice it when mirrored.
      shape = random16(8);
    }
    // The sketch moved once a frame at 120 frames a second; this steps that many times for the time
    // gone, at most four, so the motion keeps its speed at any framerate.
    int now = t / 25 * 3 + mod(t, 25) * 3 / 25;
    int steps = clamp(now - frame, 1, 4);
    frame = now;
    for (int k = 0; k < steps; k = k + 1) {
      // The sketch's PatternRotation: angular speed swinging on a sine, so the turn speeds up, slows,
      // pauses and reverses; its two rates re-drawn every 8 seconds.
      if (phaseSpeed == 0 || t / 8000 != win8) {
        win8 = t / 8000;
        if (phaseSpeed == 0) { phase = random16(65535); }
        phaseSpeed = 31 + random16(157);
        maxSpeed = 156 + random16(365);
      }
      phase = mod(phase + phaseSpeed, 65536);
      rot = mod(rot + (sin(phase) - 32768) * maxSpeed / 32768 + 65536, 65536);
    }
    fade(106);
    int theta = mod(frame, 256);
    int orient = mod(shape, 4);
    int mirrored = shape / 4;
    for (int i = 0; i < 32; i = i + 1) {
      crest[i] = quad(i * 16 + theta);
      if (orient >= 2) { crest[i] = quad(i * 16 - theta); }
    }
    for (int n = 0; n < 128; n = n + 1) {
      Coord3D q = turned(led(n));
      for (int i = 0; i < 32; i = i + 1) {
        int pos = i * 8;
        int w = crest[i];
        if (mod(orient, 2) == 0) {
          dot(q, pos, w, pos + theta);
          if (mirrored == 1) { dot(q, pos, 255 - w, pos + theta); }
        } else {
          dot(q, w, pos, pos + theta);
          if (mirrored == 1) { dot(q, 255 - w, pos, pos + theta); }
        }
      }
    }
  }
}
