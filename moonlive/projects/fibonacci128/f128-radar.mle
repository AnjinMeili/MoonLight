// Radar: a sweeping arm with a long fading trail, colored by distance from the center.
// From radar in jasoncoon/fibonacci128-touch-demo (GPL-3.0), after Aurora's PatternRadar by Jason Coon;
// for f128.mll.

class F128RadarEffect {
  int dimensions() { return 2; }

  string tags() { return "💫"; }

  // Light n where f128.mll puts it: the sketch's angle and radius (0..255) in x and y, its grid cell in z.
  Coord3D led(int n) {
    int r = 0;
    int s = 128;
    for (int k = 0; k < 8; k = k + 1) {
      if ((r + s) * (r + s) <= 128 * n + 64) { r = r + s; }
      s = s / 2;
    }
    int x = 128 + (cos(n * 25033) - 32768) * r / 32768;
    int y = 128 + (sin(n * 25033) - 32768) * r / 32768;
    return Coord3D(mod(n * 25033 / 256 + 128, 256), r * 2, (y - 3) * (height - 1) / 246 * width + (x - 2) * (height - 1) / 250);
  }
  void tick() {
    fade(6);
    int theta = mod(t / 25 * 2, 256);
    for (int n = 0; n < 128; n = n + 1) {
      Coord3D p = led(n);
      int diff = mod(p.x - theta + 256, 256);
      if (diff > 128) { diff = 256 - diff; }
      if (diff < 8) {
        addRGB(p.z, paletteRGB(mod(255 - p.y - t / 25 + 65536, 256), 255 - diff * 32));
      }
    }
  }
}
