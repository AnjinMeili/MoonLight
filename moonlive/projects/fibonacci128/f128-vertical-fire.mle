// Vertical Fire: embers rising from the bottom, drifting sideways and cooling as they climb.
// From sublimeVerticalFire in jasoncoon/fibonacci128-touch-demo (GPL-3.0), after the Sublime demos;
// for f128.mll.

class F128VerticalFireEffect {
  byte ex[16];
  byte ey[16];
  byte eh[16];
  int frame = 0;

  int dimensions() { return 2; }

  string tags() { return "💫"; }

  // Light n where f128.mll puts it: x and y on the sketch's 0..255 board, its grid cell in z.
  Coord3D led(int n) {
    int r = 0;
    int s = 128;
    for (int k = 0; k < 8; k = k + 1) {
      if ((r + s) * (r + s) <= 128 * n + 64) { r = r + s; }
      s = s / 2;
    }
    int x = 128 + (cos(n * 25033) - 32768) * r / 32768;
    int y = 128 + (sin(n * 25033) - 32768) * r / 32768;
    return Coord3D(x, y, (y - 3) * (height - 1) / 246 * width + (x - 2) * (height - 1) / 250);
  }
  // FastLED's HeatColors_p at a brightness: black through red, orange and yellow to white, its last
  // sixteenth blending back toward black as a 16-entry palette wraps.
  RGB heat(int h, int bri) {
    int r = min(h * 51 / 16, 255);
    int g = clamp((h - 80) * 51 / 16, 0, 255);
    int b = clamp((h - 160) * 51 / 16, 0, 255);
    if (h > 240) {
      r = 255 * (256 - h) / 16;
      g = r;
      b = r;
    }
    return RGB(r * (bri + 1) / 256, g * (bri + 1) / 256, b * (bri + 1) / 256);
  }
  void tick() {
    // The sketch moved once a frame at 120 frames a second; this steps that many times for the time
    // gone, at most four, so the motion keeps its speed at any framerate.
    int now = t / 25 * 3 + mod(t, 25) * 3 / 25;
    int steps = clamp(now - frame, 1, 4);
    frame = now;
    for (int k = 0; k < steps; k = k + 1) {
      for (int e = 0; e < 16; e = e + 1) {
        if (eh[e] > 0) {
          // Each slot drifts its own way, left, straight or right; an ember dies cold or past the top.
          int y = ey[e] + 3 + random16(4);
          int x = ex[e] + mod(e, 3) - 1;
          int h = eh[e] - 1 - random16(4);
          if (y > 255 || h < 30 || x < 0 || x > 255) { eh[e] = 0; }
          else { ex[e] = x; ey[e] = y; eh[e] = h; }
        } else {
          if (random16(256) < 60) {
            ex[e] = 60 + random16(136);
            ey[e] = random16(30);
            eh[e] = 200 + random16(56);
          }
        }
      }
    }
    fade(90);
    for (int n = 0; n < 128; n = n + 1) {
      Coord3D p = led(n);
      for (int e = 0; e < 16; e = e + 1) {
        if (eh[e] > 0) {
          int d = (p.x - ex[e]) * (p.x - ex[e]) + (255 - p.y - ey[e]) * (255 - p.y - ey[e]);
          if (d < 400) { addRGB(p.z, heat(eh[e], 255 * (400 - d) / 400 * (eh[e] + 1) / 256)); }
        }
      }
    }
  }
}
