// Attract: boids swinging round a gravitational center, trailing color.
// From attract in jasoncoon/fibonacci128-touch-demo (GPL-3.0), after Aurora's PatternAttract by Jason
// Coon and Daniel Shiffman's Nature of Code; for f128.mll. Seven boids where the sketch flew ten: a
// script's members hold 64 bytes.

class F128AttractEffect {
  // A position is (x + 8192) * 32768 + (y + 8192), a velocity (vx + 1024) * 2048 + (vy + 1024), in
  // 64ths of a unit of the 0..255 board.
  int pos[7];
  int vel[7];
  int frame = 0;

  int dimensions() { return 2; }

  string tags() { return "💫"; }

  // Light n where f128.mll puts it: x and y on the sketch's 0..255 board, its grid cell in z.
  Coord3D led(int n) {
    int r = 0;
    int s = 128;
    for (int k = 0; k < 8; k = k + 1) {
      if ((r + s) * (r + s) <= 128 * n + 64) { r = r + s; }
      s = s / 2;
    }
    int x = 128 + (cos(n * 25033) - 32768) * r / 32768;
    int y = 128 + (sin(n * 25033) - 32768) * r / 32768;
    return Coord3D(x, y, (y - 3) * (height - 1) / 246 * width + (x - 2) * (height - 1) / 250);
  }
  // Add a palette color to light p, brighter the nearer it lies to (dx, dy), out to 20 units on the
  // board: the sketch's way of drawing a point on lights that sit on no grid.
  void dot(Coord3D p, int dx, int dy, int index) {
    int d = (p.x - dx) * (p.x - dx) + (p.y - dy) * (p.y - dy);
    if (d < 400) { addRGB(p.z, paletteRGB(mod(mod(index, 256) + 256, 256), 255 * (400 - d) / 400)); }
  }
  // A vector scaled to length m, the sketch's normalize() then multiply.
  Coord3D setMag(Coord3D v, int m) {
    int d = polarR(v.x, v.y);
    if (d == 0) { return Coord3D(0, 0, 0); }
    return Coord3D(v.x * m / d, v.y * m / d, 0);
  }

  // A vector shortened to length m when it is longer.
  Coord3D limit(Coord3D v, int m) {
    if (polarR(v.x, v.y) > m) { return setMag(v, m); }
    return v;
  }
  void tick() {
    if (pos[0] == 0) {
      // A column above the center, all thrown sideways the same way at speeds of their own.
      int dir = random16(2) * 2 - 1;
      for (int i = 0; i < 7; i = i + 1) {
        pos[i] = (127 * 64 + 8192) * 32768 + (255 - i * 25) * 64 + 8192;
        vel[i] = (dir * (102 + random16(48) * 64 / 10) + 1024) * 2048 + 1024;
      }
    }
    // The sketch moved once a frame at 120 frames a second; this steps that many times for the time
    // gone, at most four, so the motion keeps its speed at any framerate.
    int now = t / 25 * 3 + mod(t, 25) * 3 / 25;
    int steps = clamp(now - frame, 1, 4);
    frame = now;
    for (int k = 0; k < steps; k = k + 1) {
      for (int i = 0; i < 7; i = i + 1) {
        int x = pos[i] / 32768 - 8192;
        int y = mod(pos[i], 32768) - 8192;
        // Pulled toward (128, 128) by G M / d^2, d held between 40 and 256 units.
        int d = clamp(polarR(128 * 64 - x, 128 * 64 - y) / 64, 40, 256);
        Coord3D f = setMag(Coord3D(128 * 64 - x, 128 * 64 - y, 0), 163840 / (d * d));
        Coord3D v = limit(Coord3D(vel[i] / 2048 - 1024 + f.x, mod(vel[i], 2048) - 1024 + f.y, 0), 768);
        pos[i] = (clamp(x + v.x, -8192, 24575) + 8192) * 32768 + clamp(y + v.y, -8192, 24575) + 8192;
        vel[i] = (v.x + 1024) * 2048 + v.y + 1024;
      }
    }
    // The sketch faded by 255 - beatsin8(2, 150, 230) at 120 frames a second.
    int a = 105 - scale(sin(beat(2, t)), 80);
    fade(256 - (256 - a) * (256 - a) / 256);
    for (int n = 0; n < 128; n = n + 1) {
      Coord3D p = led(n);
      for (int i = 0; i < 7; i = i + 1) {
        dot(p, (pos[i] / 32768 - 8192) / 64, (mod(pos[i], 32768) - 8192) / 64, i * 24);
      }
    }
  }
}
